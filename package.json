{
  "name": "medlens",
  "version": "1.0.0",
  "description": "MedLens — AI-Powered Clinical Information Intelligence",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "start": "node backend/src/server.js",
