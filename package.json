    "frontend": "npm run dev --workspace=frontend",
    "test": "npm test --workspace=backend",
    "install:all": "npm install"
  },
  "keywords": [
    "clinical-nlp",
    "anti-hallucination",
    "provenance",
    "hl7-fhir",
    "abdm",
    "smart-india-hackathon"
  ],
  "author": "MedLens Team",
  "license": "MIT",
  "dependencies": {
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1"
  }
}
